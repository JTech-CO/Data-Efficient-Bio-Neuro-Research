{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic closed-loop research run v1.1.0",
  "type": "object",
  "required": [
    "schema_version",
    "config",
    "run_id",
    "evidence_status",
    "real_data_validation",
    "budget",
    "model_card",
    "assumption_register",
    "model_hash",
    "snapshots",
    "observations",
    "events",
    "final",
    "config_hash",
    "deterministic_payload_sha256",
    "execution",
    "stop_reason"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "real_data_validation": {
      "const": false
    },
    "evidence_status": {
      "const": "synthetic-pilot-only"
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/measurement"
      }
    },
    "snapshots": {
      "type": "array",
      "minItems": 1
    },
    "events": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "index",
          "type",
          "payload",
          "previous",
          "hash"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "previous": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "deterministic_payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "condition",
        "time",
        "readout",
        "intervention",
        "fidelity",
        "replicate",
        "group"
      ],
      "properties": {
        "condition": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "time": {
          "const": 1
        },
        "readout": {
          "enum": [
            "sum",
            "first"
          ]
        },
        "intervention": {
          "enum": [
            "none",
            "attenuate_b"
          ]
        },
        "fidelity": {
          "enum": [
            "high",
            "low"
          ]
        },
        "replicate": {
          "enum": [
            0,
            1
          ]
        },
        "group": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "query",
        "value",
        "noise_sd",
        "cost",
        "split",
        "group_id",
        "origin",
        "parent_ids",
        "counts_as_new_biological_unit",
        "producer_fit_split"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "query": {
          "$ref": "#/$defs/query"
        },
        "value": {
          "type": "number"
        },
        "noise_sd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cost": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "split": {
          "enum": [
            "train",
            "validation",
            "test"
          ]
        },
        "group_id": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "const": "simulated"
        },
        "parent_ids": {
          "type": "array",
          "maxItems": 0
        },
        "counts_as_new_biological_unit": {
          "const": false
        },
        "producer_fit_split": {
          "const": "not_fitted"
        }
      }
    }
  }
}
